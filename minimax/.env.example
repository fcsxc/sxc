# MiniMax 凭据（仅在重放「MiniMax 修改代码」这一步需要）
# 从 MiniMax 开放平台获取，勿提交真实值。
MINIMAX_API_KEY=

# 可选：模型与协议
# MINIMAX_MODEL=MiniMax-Text-01
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# MINIMAX_PROTOCOL=minimax      # minimax | anthropic

# 可选：上下文模块与 PowerContext 的地址
# POWERCONTEXT_URL=http://127.0.0.1:8000
# SDDCTX_SCOPE_TITLE=orderflow-refund-sdd
# SDDCTX_DATA_DIR=.data
